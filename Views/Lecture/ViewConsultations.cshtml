@model List<SmartCampusMVC.Models.Consultation>

<h2>Student Consultations</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Lecturer</th>
            <th>Date</th>
            <th>Time</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentId</td>
                <td>@item.Lecturer</td>
                <td>@item.ConsultationDate.ToShortDateString()</td>
                <td>@item.ConsultationTime</td>
                <td>@item.Reason</td>
                <td>@item.Status</td>

                <td>
                    @if (item.Status == "Pending")
                    {
                        <a asp-action="ApproveConsultation" asp-route-id="@item.Id" class="btn btn-success btn-sm">
                            Approve
                        </a>

                        <a asp-action="RejectConsultation" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            Reject
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Locked</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>