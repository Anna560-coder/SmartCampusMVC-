@model SmartCampusMVC.Models.Issues

<h2>Issue Details</h2>

<hr />

<div class="card p-3">
    <p>
        <strong>Issue:</strong>
        @(Model.IssueType == "Other" ? Model.CustomIssue : Model.IssueType)
    </p>

    <p><strong>Description:</strong> @Model.Description</p>

    <p><strong>Status:</strong> @Model.Status</p>

    <p><strong>Date:</strong> @Model.DateCreated</p>

    <p><strong>Image:</strong></p>

    @if (!string.IsNullOrEmpty(Model.FilePath))
    {
        <img src="@Model.FilePath" width="250" style="border-radius:8px;" />
    }
    else
    {
        <span>No Image</span>
    }
</div>

<br />

<a asp-action="Index" class="btn btn-secondary">Back</a>