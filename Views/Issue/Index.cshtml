@model IEnumerable<SmartCampusMVC.Models.Issues>

<style>
    img:hover {
        transform: scale(1.1);
        transition: 0.2s;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-controller="Home" asp-action="Student" class="btn btn-secondary">
        ← Back
    </a>

    <h2 class="mb-0">My Issues</h2>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Issue</th>
            <th>Image</th>
            <th>Status</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.IssueType == "Other" ? item.CustomIssue : item.IssueType)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.FilePath))
                    {
                        <a href="@item.FilePath" target="_blank">
                            <img src="@item.FilePath" width="60" height="60" style="object-fit:cover; border-radius:6px;" />
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No Image</span>
                    }
                </td>
                <td>
                    @if (item.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.Status == "Resolved")
                    {
                        <span class="badge bg-success">Resolved</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>@item.DateCreated</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary me-2" title="Edit">
                        <i class="fa fa-edit"></i>
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="text-danger"
                       onclick="return confirm('Are you sure?');"
                       title="Delete">
                        <i class="fa fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>