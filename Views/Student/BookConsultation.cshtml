@{
    ViewData["Title"] = "Book Academic Consultation";
}

<h2>Book Academic Consultation</h2>

<p>Please fill in the form below to book a consultation with a lecturer.</p>

<hr />

<!-- SUCCESS MESSAGE -->


<!-- ERROR MESSAGE -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" id="successMessage">
        @TempData["SuccessMessage"]
    </div>

    <script>
        setTimeout(function () {
            window.location.href = '/Student/ViewConsultationHistory';
        }, 2000); // 2 seconds
    </script>
}

<form asp-controller="Student" asp-action="BookConsultation" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow p-4">
        <h4 class="mb-3">Book Consultation</h4>

        <!-- SUCCESS -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }

        <!-- ERROR -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Lecturer</label>
            <select name="Lecturer" class="form-control" required>
                <option value="">Select Lecturer</option>
                <option>Dr. Paulina Phoobane</option>
                <option>Prof. Khumulani Sibande</option>
                <option>Dr. Ntima Mabanza</option>
                <option>Gadner Mwansa</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Consultation Date</label>
            <input type="date" name="ConsultationDate" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Consultation Time</label>
            <input type="time" name="ConsultationTime" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Reason</label>
            <textarea name="Reason" class="form-control" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Book Consultation
        </button>
    </div>
</form>

<br />

<form asp-controller="Home" asp-action="Student">
    <button type="submit" class="btn btn-primary mt-3">
        Back to Dashboard
    </button>
</form>