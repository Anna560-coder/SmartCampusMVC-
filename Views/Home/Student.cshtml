@{
    ViewData["Title"] = "Student Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome To Student Page</h1>
</div>



<hr />

<h2>Student Dashboard</h2>

<p>Welcome to the Student Portal</p>

<hr />

<h3>Available Services</h3>

<br />

<form asp-action="RequestService" asp-controller="Student">
    <button type="submit">
        Request Campus Service
    </button>
</form>

<br />

<form asp-action="ReportIssue" asp-controller="Student">
    <button type="submit">
        Report an Issue
    </button>
</form>

<br />

<form asp-action="BookConsultation" asp-controller="Student">
    <button type="submit">
        Book Academic Consultation
    </button>
</form>

<br />

<form asp-action="ViewConsultationHistory" asp-controller="Student">
    <button type="submit">
        View Booked Consultation History
    </button>
</form>

<br />

<a asp-controller="Profile" asp-action="Index">
    <button type="button">
        Manage Profile
    </button>
</a>