<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartCampusMVC</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartCampusMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        /* Global Styles */
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --bg-card: rgba(30, 41, 59, 0.8);
            --text-primary: #ffffff;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            min-height: 100vh;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* Navbar Styles */
        .smart-navbar {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 0.75rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .smart-navbar .container-fluid {
                max-width: 1400px;
                margin: 0 auto;
                padding: 0 1.5rem;
            }

            .smart-navbar .navbar-brand {
                font-size: 1.5rem;
                font-weight: 700;
                background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                transition: opacity 0.3s ease;
            }

                .smart-navbar .navbar-brand:hover {
                    opacity: 0.8;
                }

                .smart-navbar .navbar-brand::before {
                    content: '';
                    display: inline-block;
                    width: 32px;
                    height: 32px;
                    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
                    border-radius: 8px;
                    margin-right: 0.25rem;
                }

            .smart-navbar .navbar-toggler {
                border: 1px solid var(--border-color);
                padding: 0.5rem 0.75rem;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

                .smart-navbar .navbar-toggler:hover {
                    background: var(--bg-card);
                }

                .smart-navbar .navbar-toggler:focus {
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
                }

            .smart-navbar .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28148, 163, 184, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            }

            .smart-navbar .navbar-nav {
                gap: 0.25rem;
            }

            .smart-navbar .nav-item {
                position: relative;
            }

            .smart-navbar .nav-link {
                color: var(--text-secondary) !important;
                font-weight: 500;
                padding: 0.625rem 1rem !important;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .smart-navbar .nav-link:hover {
                    color: var(--text-primary) !important;
                    background: var(--bg-card);
                }

                .smart-navbar .nav-link.active,
                .smart-navbar .nav-link[aria-current="page"] {
                    color: var(--accent-blue) !important;
                    background: rgba(59, 130, 246, 0.1);
                }

            /* Auth Buttons in Navbar */
            .smart-navbar .btn-login {
                color: var(--text-secondary);
                background: transparent;
                border: 1px solid var(--border-color);
                padding: 0.5rem 1.25rem;
                border-radius: 0.5rem;
                font-weight: 500;
                transition: all 0.3s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

                .smart-navbar .btn-login:hover {
                    color: var(--text-primary);
                    background: var(--bg-card);
                    border-color: rgba(255, 255, 255, 0.2);
                }

            .smart-navbar .btn-register {
                color: #ffffff;
                background: linear-gradient(135deg, var(--accent-blue) 0%, #2563eb 100%);
                border: none;
                padding: 0.5rem 1.25rem;
                border-radius: 0.5rem;
                font-weight: 500;
                transition: all 0.3s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                box-shadow: 0 2px 10px rgba(59, 130, 246, 0.3);
            }

                .smart-navbar .btn-register:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
                    color: #ffffff;
                }

            /* User Dropdown */
            .smart-navbar .dropdown-menu {
                background: var(--bg-secondary);
                border: 1px solid var(--border-color);
                border-radius: 0.75rem;
                padding: 0.5rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
                margin-top: 0.5rem;
            }

            .smart-navbar .dropdown-item {
                color: var(--text-secondary);
                padding: 0.625rem 1rem;
                border-radius: 0.5rem;
                transition: all 0.2s ease;
            }

                .smart-navbar .dropdown-item:hover {
                    color: var(--text-primary);
                    background: var(--bg-card);
                }

            .smart-navbar .dropdown-divider {
                border-color: var(--border-color);
                margin: 0.5rem 0;
            }

            /* User Avatar/Name */
            .smart-navbar .user-info {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.5rem 1rem;
                color: var(--text-primary);
                font-weight: 500;
                cursor: pointer;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

                .smart-navbar .user-info:hover {
                    background: var(--bg-card);
                }

            .smart-navbar .user-avatar {
                width: 36px;
                height: 36px;
                background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 0.875rem;
                color: #ffffff;
            }

        /* Role Badge */
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            background: rgba(59, 130, 246, 0.1);
            color: var(--accent-blue);
            padding: 0.25rem 0.625rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }

            .role-badge.technician {
                background: rgba(16, 185, 129, 0.1);
                color: var(--accent-green);
            }

            .role-badge.student {
                background: rgba(99, 102, 241, 0.1);
                color: #818cf8;
            }

            .role-badge.lecture {
                background: rgba(245, 158, 11, 0.1);
                color: #fbbf24;
            }

        /* Main Content Area */
        .main-container {
            flex: 1;
            width: 100%;
        }

            .main-container > .container {
                max-width: 1400px;
                padding: 0;
            }

            .main-container main {
                min-height: calc(100vh - 200px);
            }

        /* Footer Styles */
        .smart-footer {
            background: var(--bg-secondary);
            border-top: 1px solid var(--border-color);
            padding: 2rem 0;
            margin-top: auto;
        }

            .smart-footer .container {
                max-width: 1400px;
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
            }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .footer-logo {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
            border-radius: 10px;
        }

        .footer-info h4 {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.25rem;
        }

        .footer-info p {
            font-size: 0.875rem;
            color: var(--text-muted);
            margin: 0;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

            .footer-links a {
                color: var(--text-secondary);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                transition: color 0.3s ease;
            }

                .footer-links a:hover {
                    color: var(--accent-blue);
                }

        .footer-copyright {
            color: var(--text-muted);
            font-size: 0.875rem;
            text-align: center;
            width: 100%;
            padding-top: 1.5rem;
            margin-top: 1rem;
            border-top: 1px solid var(--border-color);
        }

        /* Form Styles */
        .form-control,
        .form-select {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus,
            .form-select:focus {
                background: var(--bg-secondary);
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
                color: var(--text-primary);
            }

            .form-control::placeholder {
                color: var(--text-muted);
            }

        .form-label {
            color: var(--text-secondary);
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        /* Button Styles */
        .btn-primary {
            background: linear-gradient(135deg, var(--accent-blue) 0%, #2563eb 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 2px 10px rgba(59, 130, 246, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
                background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            }

        .btn-secondary {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-secondary:hover {
                background: var(--bg-secondary);
                border-color: rgba(255, 255, 255, 0.2);
                color: var(--text-primary);
            }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border: none;
            box-shadow: 0 2px 10px rgba(239, 68, 68, 0.3);
        }

            .btn-danger:hover {
                box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
            }

        .btn-success {
            background: linear-gradient(135deg, var(--accent-green) 0%, #059669 100%);
            border: none;
            box-shadow: 0 2px 10px rgba(16, 185, 129, 0.3);
        }

            .btn-success:hover {
                box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
            }

        /* Card Styles */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 1rem;
            overflow: hidden;
        }

        .card-header {
            background: rgba(30, 41, 59, 0.5);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 1.5rem;
        }

        .card-body {
            padding: 1.5rem;
        }

        .card-title {
            color: var(--text-primary);
            font-weight: 600;
        }

        .card-text {
            color: var(--text-secondary);
        }

        /* Table Styles */
        .table {
            color: var(--text-primary);
        }

            .table thead th {
                background: var(--bg-card);
                color: var(--text-secondary);
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                border-bottom: 1px solid var(--border-color);
                padding: 1rem;
            }

            .table tbody td {
                border-bottom: 1px solid var(--border-color);
                padding: 1rem;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background: rgba(59, 130, 246, 0.05);
            }

        .table-striped tbody tr:nth-of-type(odd) {
            background: rgba(30, 41, 59, 0.3);
        }

        /* Alert Styles */
        .alert {
            border: none;
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--accent-green);
            border-left: 4px solid var(--accent-green);
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: rgba(245, 158, 11, 0.1);
            color: #fbbf24;
            border-left: 4px solid #f59e0b;
        }

        .alert-info {
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
            border-left: 4px solid var(--accent-blue);
        }

        /* Responsive Adjustments */
        @@media (max-width: 991.98px) {
            .smart-navbar .navbar-collapse {
                background: var(--bg-secondary);
                border: 1px solid var(--border-color);
                border-radius: 0.75rem;
                padding: 1rem;
                margin-top: 1rem;
            }

            .smart-navbar .navbar-nav {
                gap: 0.25rem;
            }

            .smart-navbar .nav-link {
                padding: 0.75rem 1rem !important;
            }

            .footer-links {
                width: 100%;
                justify-content: center;
            }

            .footer-brand {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 576px) {
            .smart-navbar .container-fluid {
                padding: 0 1rem;
            }

            .smart-footer .container {
                padding: 0 1rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="smart-navbar navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartCampus</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check"></i> Privacy
                            </a>
                        </li>
                        @if (User.IsInRole("Technician"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Technician">
                                    <i class="bi bi-tools"></i> Technician
                                    <span class="role-badge technician">Active</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Student">
                                    <i class="bi bi-mortarboard"></i> Student
                                    <span class="role-badge student">Portal</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Lecture"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Lecture">
                                    <i class="bi bi-easel"></i> Lecture
                                    <span class="role-badge lecture">Dashboard</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="main-container">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="smart-footer">
        <div class="container">
            <div class="footer-brand">
                <div class="footer-logo"></div>
                <div class="footer-info">
                    <h4>SmartCampus</h4>
                    <p>Campus Management System</p>
                </div>
            </div>
            <div class="footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a href="#">Support</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-copyright">
                &copy; 2026 SmartCampusMVC. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>