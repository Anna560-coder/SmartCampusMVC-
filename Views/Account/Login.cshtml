@using SmartCampusMVC.ViewModels;
@model LogInViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<style>
    .account-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        position: relative;
        overflow: hidden;
        padding: 2rem 1rem;
    }

        .account-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(16, 185, 129, 0.1) 0%, transparent 50%);
            pointer-events: none;
        }

    .account-box {
        background: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.5rem;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
        position: relative;
        z-index: 1;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeInUp 0.5s ease-out;
    }

    .animation-wrapper {
        position: relative;
        margin-bottom: 1rem;
    }

    .animation-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(30px);
        pointer-events: none;
    }

    #login-animation {
        width: 180px;
        height: 180px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .account-box h2 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #ffffff;
        text-align: center;
        margin-bottom: 1.5rem;
    }

        .account-box h2 span {
            background: linear-gradient(135deg, #3b82f6 0%, #10b981 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .form-label {
        color: #94a3b8;
        font-weight: 500;
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
    }

    .form-control {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border-radius: 0.75rem;
        padding: 0.875rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background: rgba(15, 23, 42, 0.8);
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            color: #ffffff;
            outline: none;
        }

        .form-control::placeholder {
            color: #64748b;
        }

    .text-danger {
        color: #f87171 !important;
        font-size: 0.8125rem;
        margin-top: 0.375rem;
        display: block;
    }

    .validation-summary-errors {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 0.75rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.25rem;
        }

    .forgot-password-link {
        color: #60a5fa;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .forgot-password-link:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

    .form-check {
        margin-bottom: 1.5rem;
    }

    .form-check-input {
        width: 1.125rem;
        height: 1.125rem;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 0.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .form-check-input:checked {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border-color: #3b82f6;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

    .form-check-label {
        color: #94a3b8;
        font-size: 0.875rem;
        cursor: pointer;
        margin-left: 0.25rem;
    }

    .btn-login {
        width: 100%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: #ffffff;
        padding: 0.875rem 1.5rem;
        border-radius: 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

    .register-text {
        text-align: center;
        color: #94a3b8;
        margin-top: 1.5rem;
        font-size: 0.9375rem;
    }

    .register-link {
        color: #60a5fa;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .register-link:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        margin-top: 1rem;
        transition: color 0.3s ease;
    }

        .back-link:hover {
            color: #94a3b8;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .divider {
        display: flex;
        align-items: center;
        margin: 1.5rem 0;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
        }

        .divider span {
            color: #64748b;
            font-size: 0.8125rem;
            padding: 0 1rem;
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 480px) {
        .account-box {
            padding: 2rem 1.5rem;
            margin: 1rem;
        }

        #login-animation {
            width: 150px;
            height: 150px;
        }
    }
</style>

<div class="account-container">
    <div class="account-box">

        <div class="animation-wrapper">
            <div class="animation-glow"></div>
            <div id="login-animation"></div>
        </div>

        <h2>Welcome <span>Back</span></h2>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div class="form-check" style="margin-bottom: 0;">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(a => a.RememberMe)
                    </label>
                </div>
                <a asp-controller="Account" asp-action="VerifyEmail" class="forgot-password-link">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="btn-login">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                </svg>
                Login
            </button>

            <p class="register-text">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" class="register-link">Register</a>
            </p>

            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="back-link">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5" />
                        <polyline points="12 19 5 12 12 5" />
                    </svg>
                    Back to Home
                </a>
            </div>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>

<script>
    lottie.loadAnimation({
        container: document.getElementById('login-animation'),
        renderer: 'svg',
        loop: true,
        autoplay: true,
        path: '/animations/login.json'
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}